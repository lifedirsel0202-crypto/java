-- 판매금액, 판매번호, 상품명, 분류명, 판매수량, 단가, 판매금액, 구매자명
SELECT SALE_DATE, SALE_NO, PROD_NAME, CAT_NAME, SALE_QTY, UNIT_PRICE, BUYER_NAME
FROM TBL_SALE TS 
LEFT OUTER JOIN TBL_PRODUCT TP ON TS.PROD_CODE = TP.PROD_CODE
LEFT OUTER JOIN tbl_category TC ON TP.CAT_CODE=TC.CAT_CODE
ORDER BY SALE_DATE, SALE_NO;

-- 분류코드 분류명 판매건수 총판매수량 총판매금액
select tc.cat_code,tc.cat_name, ts.sale_qty
from tbl_sale ts left outer join tbl_product tp on  tp.prod_code= ts.prod_code
						left outer join tbl_category tc on tp.cat_code= tc.cat_code
group by tc.cat_code,tc.cat_name,ts.sale_qty;

